# [1] DJANGO WEB SERVER CONFIGURATION
# Tạo secret key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-django-secret-key-here
DEBUG=True
SESSION_COOKIE_AGE=86400
TRUSTED_PROXY_COUNT=0
# ALLOWED_HOSTS=your-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-domain.com

# [2] DATABASE CONFIGURATION
USE_SQLITE=False
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=blockchain_voting
DATABASE_URL=postgresql://postgres:your-postgres-password@db:5432/blockchain_voting

# [3] REDIS & WEBSOCKET CHANNELS
REDIS_URL=redis://redis:6379/0?protocol=2

# [4] BLOCKCHAIN & CHAIN WATCHER (INFURA SEPOLIA)
CHAIN_ID=11155111             # 11155111 = Sepolia | 31337 = Hardhat local
CHAIN_NAME=Sepolia
EXPLORER_URL=https://sepolia.etherscan.io
CHAIN_RPC_PUBLIC=https://ethereum-sepolia-rpc.publicnode.com
INFURA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_API_KEY
INFURA_WSS_URL=wss://sepolia.infura.io/ws/v3/YOUR_INFURA_API_KEY
FACTORY_ADDRESS=0xDiaChiFactorySauKhiDeploy
START_BLOCK=
GETLOGS_BLOCK_RANGE=10000
RECONCILE_INTERVAL=900
SCAN_SLEEP=0.5

# [5] IPFS STORAGE (PINATA)
# Lấy JWT tại: https://app.pinata.cloud -> API Keys -> New Key
PINATA_JWT=your-pinata-jwt-token-here
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
# UPLOADS_PER_HOUR=40
# MAX_IMAGE_BYTES=2097152

# [6] DEPLOYMENT KEY (LOCAL HARDHAT DEPLOY ONLY - KHÔNG ĐƯA LÊN SERVER)
# PRIVATE_KEY=0x...
